{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lumiwake",
  "version": "0.1.0",
  "identifier": "io.github.laplusdestiny.lumiwake",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Lumiwake",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "backgroundColor": "#16171a"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' lumi: http://lumi.localhost data: blob:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Photography",
    "shortDescription": "キーボードで画像をすばやく振り分ける",
    "license": "MIT"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZEQzM0MzlCNEZDNzdFMDMKUldRRGZzZFBtMFBEYllaeG9EQm1mRC8yc1lWQTFaeW44VjhUNjVZUWVUOWdseHAydmh1a3F2USsK",
      "endpoints": [
        "https://github.com/laplusdestiny/lumiwake/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
